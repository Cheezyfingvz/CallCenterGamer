# ==============================================================================
# CALLCENTERGAMER — Variables de Entorno (.env.example)
# Copiar como ".env" para desarrollo local o configurar en el panel de Render
# ==============================================================================

# --- Seguridad y Entorno Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# --- Inteligencia Artificial (Opcional: sin clave opera el motor local) ---
OPENAI_API_KEY=

# --- Parametrización White-Label / Multi-Empresa (Fase 5) ---
BRAND_NAME=CallCenterGamer
BRAND_WELCOME_TITLE=Bienvenido a Call of Gamers!
BRAND_SLOGAN=Comunicate con el mejor call center gamer, nosotros te brindaremos la solución necesaria para tu problema, no dudes más!
BRAND_SERVICE_TITLE=Atención 24/7
BRAND_CTA_TITLE=Comunicate con nosotros
BRAND_CTA_SUBTITLE=Escribenos y nuestros profesionales solucionaran tu problema en tan solo un momento!
BRAND_ICON_CLASS=fas fa-gamepad
BRAND_LOGO_STATIC=img/LOGITO.png
BRAND_PRIMARY_COLOR=#4E31E1
BRAND_SECONDARY_COLOR=#673de6
BRAND_ACCENT_COLOR=#25c2b5
BRAND_FOOTER_ADDRESS=Av. Américo Vespucio 974, Maipú, Región Metropolitana
BRAND_AI_ROLE_PROMPT=Eres un experto técnico en videojuegos y hardware gaming.
BRAND_CATEGORIES=hardware,software,conexion,cuenta,pago,rendimiento,otros

