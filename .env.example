# ==============================================================================
# CALLCENTERGAMER — Variables de Entorno (.env.example)
# Copiar como ".env" para desarrollo local o configurar en el panel de Render
# ==============================================================================

# --- Seguridad y Entorno Django ---
DJANGO_SECRET_KEY=cambia-esta-clave-secreta-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# --- Inteligencia Artificial (Opcional: sin clave opera el motor local) ---
OPENAI_API_KEY=

# --- Parametrización White-Label / Multi-Empresa (Fase 5) ---
BRAND_NAME=Call Center SoundFlow
BRAND_WELCOME_TITLE=Bienvenido a Call Center SoundFlow
BRAND_SLOGAN=Comunícate con el soporte oficial de SoundFlow, nosotros te brindaremos la solución necesaria para tu música, listas y suscripciones.
BRAND_SERVICE_TITLE=Soporte SoundFlow 24/7
BRAND_CTA_TITLE=Comunícate con nosotros
BRAND_CTA_SUBTITLE=Escríbenos y nuestros especialistas resolverán tu consulta musical y técnica en tan solo un momento.
BRAND_ICON_CLASS=fas fa-wave-square
BRAND_LOGO_STATIC=img/LOGITO.png
BRAND_PRIMARY_COLOR=#1DB954
BRAND_SECONDARY_COLOR=#181818
BRAND_ACCENT_COLOR=#1ed760
BRAND_FOOTER_ADDRESS=Av. Américo Vespucio 974, Maipú, Región Metropolitana
BRAND_AI_ROLE_PROMPT=Eres un experto técnico en soporte de SoundFlow, música digital, streaming y helpdesk.
BRAND_CATEGORIES=hardware,software,conexion,cuenta,pago,rendimiento,suscripciones,descargas,biblioteca,playlists,recomendaciones,reproductor,contenido_musical,problemas_tecnicos,otros

# --- Configuración SoundFlow / Metadatos Musicales (Opcional) ---
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=SoundFlow/1.0 ( contacto@example.com )
MUSICBRAINZ_TIMEOUT=8
MUSICBRAINZ_CACHE_SECONDS=86400
COVER_ART_TIMEOUT=6


